# Base agent image: the compiled agent code and nothing language-specific.
#
# The refiner runs on this directly — it only reads source, so it needs no
# toolchain. The implementer and reviewer run on stack images that layer their
# language runtimes on top (Dockerfile.node, .python, .jvm), because both have
# to actually execute the repo's build and test commands.
#
# Build context is the REPO ROOT:
#   docker build -f services/agents/Dockerfile.base -t agents-base:local .
#
# Debian slim rather than Alpine, deliberately. The agents run arbitrary test
# suites from target repos, and musl breaks a long tail of native Node addons
# and most manylinux Python wheels. The extra ~40 MB is far cheaper than
# debugging why a repo's suite passes on a developer's laptop and not here.

FROM node:22-bookworm-slim AS build
WORKDIR /app

COPY package.json package-lock.json* tsconfig.base.json tsconfig.json ./
COPY packages/shared/package.json packages/shared/
COPY services/agents/package.json services/agents/

RUN npm ci --workspaces --include-workspace-root

COPY packages/shared packages/shared
COPY services/agents services/agents

RUN npm run build --workspace @cloud-harness/agents
RUN npm prune --omit=dev --workspaces --include-workspace-root

FROM node:22-bookworm-slim AS runtime
WORKDIR /app

ENV NODE_ENV=production

# git is needed by every agent (clone, branch, push). ca-certificates for HTTPS
# to Jira, Bitbucket, and the model endpoint.
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      git \
      ca-certificates \
      openssh-client \
      curl \
      jq \
 && rm -rf /var/lib/apt/lists/*

COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/packages/shared/dist ./packages/shared/dist
COPY --from=build /app/packages/shared/package.json ./packages/shared/package.json
COPY --from=build /app/services/agents/dist ./dist
COPY --from=build /app/services/agents/package.json ./package.json

# WORKSPACE_DIR in the task definitions. Owned by node so agents clone into it
# without running as root — the repo's test suite runs here too, and root is a
# poor idea when the code being executed was just written by a model.
RUN mkdir -p /workspace && chown -R node:node /workspace
USER node

# Overridden per task definition:
#   ["node", "dist/refiner/main.js"]
#   ["node", "dist/implementer/main.js"]
#   ["node", "dist/reviewer/main.js"]
CMD ["node", "dist/refiner/main.js"]
