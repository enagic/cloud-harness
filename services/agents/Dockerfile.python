# Python stack image.
#
#   docker build -f services/agents/Dockerfile.python \
#     --build-arg BASE_IMAGE=agents-base:local -t agents-python:local .
#
# Note the agent process itself is still Node — only the code under test is
# Python. Both runtimes are present on purpose.

ARG BASE_IMAGE
FROM ${BASE_IMAGE}

USER root

# python3-venv matters: Debian marks the system Python as externally managed
# (PEP 668), so a bare `pip install` fails. Repos are expected to create a venv
# or use uv, and both need this present.
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      python3 \
      python3-dev \
      python3-venv \
      python3-pip \
      build-essential \
      libpq-dev \
      pkg-config \
 && rm -rf /var/lib/apt/lists/*

# uv handles the common cases (resolve, sync, run) far faster than pip and is
# what most new Python repos reach for. Installed system-wide so the `node` user
# can invoke it.
RUN curl -LsSf https://astral.sh/uv/install.sh \
      | env UV_INSTALL_DIR=/usr/local/bin INSTALLER_NO_MODIFY_PATH=1 sh

USER node

ENV CLOUD_HARNESS_STACK=python
# Unbuffered so a failing test suite's output reaches CloudWatch before the task
# exits, rather than dying in a pipe buffer.
ENV PYTHONUNBUFFERED=1
