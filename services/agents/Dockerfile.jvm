# JVM stack image (Java / Kotlin).
#
#   docker build -f services/agents/Dockerfile.jvm \
#     --build-arg BASE_IMAGE=agents-base:local -t agents-jvm:local .
#
# The largest of the stack images by a wide margin (~450 MB added). That is the
# real cost of the per-stack split: a single fat image carrying every runtime
# would push this onto every task, including refiners that never compile
# anything.

ARG BASE_IMAGE
FROM ${BASE_IMAGE}

USER root

# JDK 21 comes from Adoptium, not from Debian. Bookworm ships openjdk-17 and
# nothing newer — there is no openjdk-21 package in bookworm or in
# bookworm-backports, so `apt-get install openjdk-21-jdk-headless` cannot
# succeed here however it is spelled. The options were Temurin's apt repo, a
# pinned tarball, or dropping to 17; Temurin keeps the version this image is
# documented to carry and stays an apt package, so security updates arrive the
# same way everything else in the image gets them.
#
# The key is stored ASCII-armored rather than dearmored, which apt has accepted
# since 1.4 and which avoids pulling gnupg into the image for one command.
#
# Maven still comes from Debian: with Temurin already installed it satisfies
# maven's java dependency, so apt adds no second JRE. Verify that if this
# ordering ever changes — Debian's maven pulls openjdk-17-jre-headless and
# default-jre-headless on its own, which is ~200 MB of a JVM nothing runs.
RUN mkdir -p /etc/apt/keyrings \
 && curl -fsSL https://packages.adoptium.net/artifactory/api/gpg/key/public \
      -o /etc/apt/keyrings/adoptium.asc \
 && echo "deb [signed-by=/etc/apt/keyrings/adoptium.asc] https://packages.adoptium.net/artifactory/deb bookworm main" \
      > /etc/apt/sources.list.d/adoptium.list \
 && apt-get update \
 && apt-get install -y --no-install-recommends \
      temurin-21-jdk \
      maven \
 && rm -rf /var/lib/apt/lists/*

# arm64 because the task definitions pin Graviton and build-and-push.sh always
# builds linux/arm64; this path carries the architecture in its name.
ENV JAVA_HOME=/usr/lib/jvm/temurin-21-jdk-arm64
ENV PATH="${JAVA_HOME}/bin:${PATH}"

# Most repos ship a Gradle wrapper (./gradlew) and should use it — a pinned
# wrapper is the whole point. No system Gradle is installed; if a repo needs one
# it should say so, and that is a signal worth seeing rather than papering over.

# Warm, writable Maven and Gradle caches. Without these the first build in every
# task runs as a cold download of the entire dependency tree, which on a 4 vCPU
# task is minutes of wall clock charged to the attempt.
RUN mkdir -p /home/node/.m2 /home/node/.gradle \
 && chown -R node:node /home/node/.m2 /home/node/.gradle

USER node

ENV CLOUD_HARNESS_STACK=jvm
# Containers report host CPU/memory to older JVMs; this keeps a test suite from
# sizing its heap against the instance rather than the task limit.
ENV JAVA_TOOL_OPTIONS="-XX:MaxRAMPercentage=75.0"
