{
  "name": "cloud-harness",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "tsc --build",
    "clean": "tsc --build --clean && rm -rf packages/*/dist services/*/dist",
    "lint": "echo 'TODO: pick a linter (eslint/biome) and wire it here' && exit 0",
    "test": "npm run build && node --test \"packages/*/dist/**/*.test.js\" \"services/*/dist/**/*.test.js\"",
    "preflight": "npm run build && node --env-file-if-exists=.env.local services/watcher/dist/preflight.js"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
