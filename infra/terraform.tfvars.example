# cp terraform.tfvars.example terraform.tfvars and fill in.
# No secrets here — credentials go into Secrets Manager via scripts/put-secrets.sh.

project_name = "cloud-harness"
environment  = "poc"
aws_region   = "us-east-1"

# --- Jira -------------------------------------------------------------------

jira_base_url    = "https://your-org.atlassian.net"
jira_project_key = "ENG"
jira_user_email  = "automation@your-org.com"

# The dedicated bot account, and the in-flight marker. A ticket assigned to it
# is being worked on by an agent right now. The account needs `Assignable User`
# in the project's permission scheme, which is a SEPARATE permission from write
# access — without it the bot edits and transitions fine while silently failing
# to be assigned. `npm run preflight` checks.
jira_bot_account_id = "5b10a2844c20165700ede21g"

# The four fields the columns cannot carry. Ids, not names — read them off
# /rest/api/3/field. A rename must not break history counting, which is why the
# attempt budget is keyed on the id.
jira_fields = {
  code_reviewer       = "customfield_10101" # userpicker
  dor                 = "customfield_10102" # multicheckbox, ticked = gate 1 passed
  story_points        = "customfield_10016" # number, written by the refiner
  acceptance_criteria = "customfield_10103" # textarea, written by the refiner
  # dor_ticked_value  = "Yes"
}

# The columns below MUST already exist on the board, with transitions between
# them permitted for the automation account. Jira resolves transitions by name,
# so a column that is missing or spelled differently is a ticket that silently
# never moves. Defaults shown — override to match an existing board.
#
# These are ordinary columns rather than pipeline-specific ones, deliberately:
# most teams cannot add columns to their own board.
#
# jira_statuses = {
#   to_do       = "To Do"       # drafting, refinement, human gate 1
#   in_progress = "In Progress" # the implementer's column
#   code_review = "Code Review" # review, rebase, consented fix
#   validation  = "Validation"  # human gate 2 — QA, then the merge
#   done        = "Done"
#   blocked     = "Blocked"
#   closed      = "Closed"      # recognised, never read or written
# }
#
# The lane marker, and the only label the pipeline reads. Present means the
# agents own the ticket, absent means a human does. It is standing consent, not
# a trigger: it is not consumed on dispatch and survives until a human removes
# it. To edit a ticket the agents are working on, move it to the human lane
# first — editing it in the agent lane is a broken contract and the agent wins.
# jira_agent_label = "agent"

# Implementation attempts before a ticket is blocked for human triage, counted
# as In Progress -> Code Review transitions since the last DOR tick. A rebase
# never leaves Code Review and so cannot produce that edge, which is what
# exempts it — structurally, with no rule to get wrong. Ticking DOR again grants
# a fresh budget, and Jira records who did it.
# max_implementation_attempts = 3

# --- Bitbucket --------------------------------------------------------------

bitbucket_workspace      = "your-workspace"
bitbucket_default_repo   = "your-repo"
bitbucket_default_branch = "main"

# --- Tech stacks ------------------------------------------------------------
# Each stack is one container image carrying that ecosystem's toolchain, plus a
# queue + task definition + dispatcher for every runtime-needing agent. The
# implementer and reviewer must be able to run the repo's build and test
# commands, so the image is chosen at dispatch time from the repo's
# .cloud-harness.yml (see docs/example-cloud-harness.yml).
#
# Adding a stack: add an entry here, add services/agents/Dockerfile.<key>,
# apply, then `make images`. Removing one destroys its queues — drain them first.
#
# Defaults are node, python, and jvm; see variables.tf for the full shape.
# Trim the list to what you actually have repos for: each stack adds two units
# (implementer + reviewer), and each unit is a queue, a DLQ, a task definition,
# a Lambda, and three alarms.
#
# stacks = {
#   node = {
#     dockerfile    = "services/agents/Dockerfile.node"
#     description   = "Node 22 + corepack + node-gyp toolchain"
#     default_setup = "npm ci"
#     default_build = "npm run build --if-present"
#     default_test  = "npm test"
#     default_lint  = "npm run lint --if-present"
#   }
# }

# Used for repos with no .cloud-harness.yml. Must be a key in `stacks`.
# A repo whose manifest names an UNKNOWN stack is failed with a comment instead
# of falling back here.
# default_stack = "node"

# --- Model access -----------------------------------------------------------
# POC: OpenAI-compatible endpoint. Populate the llm-api-key secret afterwards.

llm_provider      = "openai_compatible"
llm_base_url      = "https://your-gateway.internal/v1"
llm_default_model = "your-model-id"

# Bedrock: flip provider, drop llm_base_url, set Bedrock model ids, and enable
# the IAM grant. No API key secret is created in this mode.
#
# llm_provider          = "bedrock"
# enable_bedrock_access = true
# bedrock_region        = "us-east-1"
# llm_default_model     = "us.anthropic.claude-sonnet-4-5-20250929-v1:0"
#
# Narrow this before prod — the default grants every model in the region.
# bedrock_allowed_model_arns = [
#   "arn:aws:bedrock:us-east-1::foundation-model/<model-id>",
# ]

# --- Agent sizing -----------------------------------------------------------
# Overriding one agent means supplying the whole map. Defaults are in
# variables.tf; this block shows the shape and the reasoning behind the sizes.
#
# agents = {
#   # Reads the repo for context and writes prose. No build, no tests.
#   refiner = {
#     entrypoint                 = "dist/refiner/main.js"
#     cpu                        = 1024   # 1 vCPU
#     memory                     = 4096   # 4 GB
#     ephemeral_storage_gb       = 30
#     max_concurrency            = 3
#     max_items_per_task         = 1
#     visibility_timeout_seconds = 1800
#     max_receive_count          = 3
#     use_fargate_spot           = false
#     model                      = ""     # empty inherits llm_default_model
#     reasoning_effort           = ""
#   }
#
#   # The heavy one: clones, builds, tests, iterates.
#   implementer = {
#     entrypoint                 = "dist/implementer/main.js"
#     cpu                        = 4096   # 4 vCPU
#     memory                     = 16384  # 16 GB
#     ephemeral_storage_gb       = 50
#     max_concurrency            = 3
#     max_items_per_task         = 1
#     visibility_timeout_seconds = 3600
#     max_receive_count          = 3
#     use_fargate_spot           = false
#     model                      = ""
#     reasoning_effort           = ""
#   }
#
#   # Checks out and exercises the branch — needs a real build environment.
#   reviewer = {
#     entrypoint                 = "dist/reviewer/main.js"
#     cpu                        = 2048   # 2 vCPU
#     memory                     = 8192   # 8 GB
#     ephemeral_storage_gb       = 50
#     max_concurrency            = 3
#     max_items_per_task         = 1
#     visibility_timeout_seconds = 3600
#     max_receive_count          = 3
#     use_fargate_spot           = false
#     model                      = ""
#     reasoning_effort           = ""
#   }
# }

# --- Watcher ----------------------------------------------------------------

# watcher_cpu                   = 256  # 0.25 vCPU
# watcher_memory                = 512
# watcher_poll_interval_seconds = 60

# --- Cost / ops -------------------------------------------------------------

# single_nat_gateway = true   # false for prod: one NAT per AZ
# log_retention_days = 30
# alarm_email        = "platform-alerts@your-org.com"

# --- Disposability ----------------------------------------------------------
# For a stack that gets destroyed and recreated — an experiment run for a day at
# a time. Both are wrong for production; see variables.tf for what they give up.
#
# Without these, a destroy is neither clean nor repeatable: ECR refuses to
# delete once any image has been pushed, and secrets enter a 7-day recovery
# window that keeps their NAMES reserved, so the next apply fails.
#
# disposable_deployment = true
#
# Container Insights makes AWS create a performance log group outside
# Terraform's state, which then survives every destroy.
#
# enable_container_insights = false
