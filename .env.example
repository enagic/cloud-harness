# Local-only configuration for `npm run preflight`.
#
#   cp .env.example .env.local && $EDITOR .env.local
#
# .env.local is gitignored. In the deployed system none of this comes from a
# file — the non-secret values are set by the ECS task definitions in
# infra/ecs.tf and infra/agents.tf, and the three secrets come from Secrets
# Manager via `make secrets`. Keep this file in sync with config.ts.

# --- Jira -------------------------------------------------------------------
# No trailing slash. For Atlassian Cloud this is https://<site>.atlassian.net
JIRA_BASE_URL=https://your-sandbox.atlassian.net
JIRA_PROJECT_KEY=CH
# The account the API token belongs to. Basic auth is email:token.
JIRA_USER_EMAIL=you@example.com
# Atlassian Cloud API token (the ATATT… format). SECRET — never commit.
JIRA_API_TOKEN=

# --- Pipeline workflow ------------------------------------------------------
# These must match the board's status names EXACTLY. Jira resolves transitions
# by name, so a mismatch is a ticket that silently never moves. Preflight
# checks every one of them and tells you which are missing.
STATUS_REFINING=Refining
STATUS_REFINEMENT_REVIEW=Refinement Review
STATUS_READY_TO_IMPLEMENT=Ready for Implementation
STATUS_IMPLEMENTING=Implementing
STATUS_CODE_REVIEW=Code Review
STATUS_REVIEWING=Reviewing
STATUS_CHANGES_REQUESTED=Changes Requested
STATUS_REBASE_REQUIRED=Rebase Required
STATUS_AWAITING_MERGE=Awaiting Merge
STATUS_DONE=Done
STATUS_FAILED=Agent Failed

LABEL_REFINE=agent-refine
LABEL_CHANGES_REQUESTED=agent-changes-requested

MAX_IMPLEMENTATION_ATTEMPTS=3

# --- Bitbucket --------------------------------------------------------------
# A separate credential from Jira. A Jira-scoped Atlassian API token does NOT
# authenticate here — it returns 401 "not supported for this endpoint".
# App passwords were removed in July 2026; the two current options are:
#   a) Repository Access Token  -> Bearer auth, git username x-token-auth
#   b) API token with scopes    -> Basic email:token, needs BITBUCKET_EMAIL
BITBUCKET_WORKSPACE=your-workspace
BITBUCKET_DEFAULT_REPO=your-test-repo
BITBUCKET_DEFAULT_BRANCH=main
# Only for option (b). Leave unset when using a repository access token.
BITBUCKET_EMAIL=

# One credential per identity. There is deliberately no fallback between them:
# a fallback would let production silently collapse the implementer and the
# reviewer into one account, and Bitbucket does not count an approval from a
# pull request's own author towards a minimum-approval merge check. The
# reviewer's approve call would return 200 and the PR would stay unmergeable.
#
# In a sandbox, paste the same token into all three. Preflight warns when the
# implementer's and reviewer's match, so the compromise stays visible.
#
# Read-only: watcher PR polling and refiner repo reads.
BITBUCKET_TOKEN=
# Pushes branches, opens pull requests.
BITBUCKET_IMPLEMENTER_TOKEN=
# Comments and approves. A different service account in production.
BITBUCKET_REVIEWER_TOKEN=

# --- Model ------------------------------------------------------------------
# openai_compatible | bedrock
LLM_PROVIDER=openai_compatible
# Must include the version path, e.g. https://api.example.com/v1
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_REQUEST_TIMEOUT_SECONDS=300
# Completion budget per call. A reasoning model spends this on hidden thinking
# BEFORE the answer, so a value sized for the reply alone comes back empty.
LLM_MAX_OUTPUT_TOKENS=8192
# Forwarded only where the endpoint supports it. Ignored on Bedrock, which takes
# a thinking token budget rather than an effort level.
LLM_REASONING_EFFORT=
# Whether the endpoint enforces a JSON schema server-side. Leave on unless the
# gateway rejects `response_format: json_schema` outright — with it off the
# provider strips the schema and only warns, so the model never learns what
# shape to answer in and every structured call fails validation.
LLM_STRUCTURED_OUTPUTS=true
# Required when LLM_PROVIDER=bedrock, ignored otherwise. No API key goes with
# it: credentials come from the ECS task role via the AWS credential chain.
BEDROCK_REGION=

# --- Refiner ----------------------------------------------------------------
# Tool-call rounds the refiner gets to read the repo before it writes the story.
REFINER_MAX_STEPS=12
# Replaces the whole system prompt, including the team conventions the default
# only has a TODO for. See DEFAULT_SYSTEM_PROMPT in
# services/agents/src/refiner/refine.ts.
REFINER_SYSTEM_PROMPT=

# --- Stacks -----------------------------------------------------------------
KNOWN_STACKS=node,python,jvm
DEFAULT_STACK=node
